{
  "name": "@kurone-kito/web-toybox",
  "version": "0.1.0",
  "private": true,
  "description": "A collection of generic npm libraries for various apps.",
  "keywords": [
    "library",
    "npm",
    "utilities"
  ],
  "homepage": "https://github.com/kurone-kito/web-toybox#readme",
  "bugs": "https://github.com/kurone-kito/web-toybox/issues",
  "repository": "github:kurone-kito/web-toybox",
  "license": "MIT",
  "author": "kurone-kito <krone@kit.black> (https://kit.black/)",
  "type": "module",
  "files": [],
  "scripts": {
    "clean": "rimraf -g \"*.tgz\" \"*.tsbuildinfo\" node_modules/.cache",
    "lint": "pnpm run --stream \"/lint:check:.+/\"",
    "lint:check:biome": "biome check",
    "lint:check:cspell": "cspell lint --show-suggestions .",
    "lint:check:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:fix": "pnpm run --stream \"/(lint:fix:.+|lint:check:cspell)/\"",
    "lint:fix:biome": "biome check --write",
    "lint:fix:markdown": "markdownlint-cli2 --fix \"**/*.md\"",
    "prepare": "husky",
    "test": "pnpm run lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@cspell/cspell-types": "^10.0.1",
    "@kurone-kito/biome-config": "^0.23.0-alpha.1",
    "@kurone-kito/commitlint-config": "^0.23.0-alpha.1",
    "@kurone-kito/cspell-config": "^0.23.0-alpha.1",
    "@kurone-kito/idd-skill": "github:kurone-kito/idd-skill#v0.11.0",
    "@kurone-kito/lint-staged-config": "^0.23.0-alpha.1",
    "@kurone-kito/markdownlint-config": "^0.23.0",
    "@kurone-kito/typescript-config": "^0.22.0-alpha.9",
    "cspell": "^10.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "markdownlint-cli2": "^0.23.0",
    "rimraf": "^6.1.3",
    "typescript": "~7.0.2"
  },
  "packageManager": "pnpm@12.4.0+sha512.37536c26ed40ab4134b6511e09f6b27f3ebb45687468f2406ca3805279a4e5ca158c1931350ad9774d6ab2108d71b3dbaeb39943159294375e4d053e8e05685c",
  "engines": {
    "node": "^22.23.2 || ^24.2.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
